<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.system</groupId>
    <artifactId>distributed-job-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Distributed Job Processing System</name>
    <description>Root POM for Distributed Job Processing System</description>

    <!-- Modules -->
    <modules>
        <module>common</module>
        <module>api</module>
        <module>worker</module>
    </modules>

    <!-- Project Properties -->
    <properties>
        <java.version>17</java.version>
        <!-- release, not just source/target: a newer JDK then also rejects APIs that
             Java 17 doesn't have, so a build with JDK 21 can't pass where CI (17) fails -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.2.4</spring-boot.version>
        <!-- Spring Boot 3.2 pins Flyway 9.22, which predates PostgreSQL 16 and warns at
             startup. 10.10.0 is the version Spring Boot moved to in its next release (3.3). -->
        <flyway.version>10.10.0</flyway.version>
        <!-- Spring Boot 3.2 pins Testcontainers 1.19.7, which talks to Docker with API
             version 1.32. Newer Docker Engines refuse anything below 1.40, so the tests
             failed on GitHub's runners ("client version 1.32 is too old") while passing
             on Docker 27 locally. 1.21.4 works with recent Docker Engines. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <!-- Dependency Version Management -->
    <dependencyManagement>
        <dependencies>

            <!-- Flyway, ahead of Spring Boot's list: with an imported dependency list the
                 first declaration wins, and a property can't override an import -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Since Flyway 10, PostgreSQL support is a separate module -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Testcontainers, also ahead of Spring Boot's list, for the same reason.
                 Its own dependency list keeps every Testcontainers module on one version. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot dependency versions -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal common module version -->
            <dependency>
                <groupId>com.system</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- Build Configuration -->
    <!-- Declared here, applied only by modules that list it (api), so common stays a plain library jar -->
    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>