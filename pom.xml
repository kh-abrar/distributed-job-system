<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.system</groupId>
    <artifactId>distributed-job-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Distributed Job Processing System</name>
    <description>Root POM for Distributed Job Processing System</description>

    <!-- Modules -->
    <modules>
        <module>common</module>
        <module>api</module>
        <module>worker</module>
    </modules>

    <!-- Project Properties -->
    <properties>
        <java.version>21</java.version>
        <!-- release, not just source/target: a newer JDK then also rejects APIs that
             this Java version doesn't have, so a local build can't pass where CI fails.
             When release is set, Maven ignores source and target; they stay for IDEs,
             some of which don't read maven.compiler.release when importing a project. -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Importing Spring Boot's dependency list manages libraries but not Maven
             plugins, so these follow what Spring Boot 4.1.2 recommends -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    </properties>

    <!-- Dependency Version Management. Spring Boot 4.1 manages current versions of
         Flyway (12.4) and Testcontainers (2.0); the overrides 3.2 needed are gone. -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot dependency versions -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal common module version -->
            <dependency>
                <groupId>com.system</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- Build Configuration -->
    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>

                <!-- Declared here, applied only by modules that list it (api, worker),
                     so common stays a plain library jar -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
